{
  "name": "gradient-atlas",
  "version": "0.1.0",
  "description": "A source-traceable interactive course from machine-learning fundamentals to the moving AI frontier.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mushfique-dgist/gradient-atlas.git"
  },
  "homepage": "https://gradient-atlas.pages.dev",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run test:rendered",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "verify:content": "node --experimental-strip-types scripts/verify-content.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify": "npm run test:unit && npm run verify:content && npm run typecheck && npm run lint && npm run build && npm run test:rendered && npm run test:e2e"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/workers-types": "5.20260815.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module"
}
